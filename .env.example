# Copie este arquivo para `.env` (ou `.env.local`) e preencha com valores reais.
# NUNCA versione o arquivo preenchido — `.env` e `.env*.local` estão no .gitignore.

# --- Supabase ---
# Project Settings -> API, no dashboard do seu projeto Supabase.

# URL do projeto. Cloud: https://SEU-REF.supabase.co | Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / publishable). Pode ir para o browser — protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role). IGNORA RLS — uso server-only. NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud TTS (Fase posterior) ---
# JSON da service account, em uma linha. Usado para gerar áudios TTS.
GOOGLE_TTS_CREDENTIALS_JSON=

# --- App ---
# URL base da aplicação. Dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development
